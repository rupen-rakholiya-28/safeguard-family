<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Theme (Light) -->
    <style name="Theme.SafeGuardChild" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.SafeGuard.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.SafeGuard.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.SafeGuard.Button.SOS" parent="Widget.Material3.Button">
        <item name="cornerRadius">50dp</item>
        <item name="backgroundTint">@color/sos_red</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>

    <style name="Widget.SafeGuard.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.SafeGuard.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SafeGuard.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
